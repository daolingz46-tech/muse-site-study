.page{padding:32rpx 28rpx 80rpx;color:#1f2c42}.header{padding:16rpx 6rpx 32rpx}.brand{font-size:42rpx;font-weight:750}.subtitle,.description,.hint,.footer{color:#7e8ca1;font-size:24rpx;line-height:1.6}.subtitle{margin-top:8rpx}.tabs,.methods{display:flex;gap:12rpx}.tabs button,.methods button{flex:1;margin:0;font-size:25rpx;background:#e9eef5;color:#66768d}.tabs button.active,.methods button.chosen{background:#294c89;color:white}.section{background:white;border-radius:24rpx;padding:28rpx;margin-top:24rpx}.section-title{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.plan{display:flex;justify-content:space-between;align-items:center;gap:14rpx;padding:22rpx;border:2rpx solid #e8edf3;border-radius:16rpx;margin-top:12rpx}.plan.selected{border-color:#7297e0;background:#f5f8ff}.name{font-size:27rpx;font-weight:600}.description{margin-top:6rpx}.price{font-size:30rpx;font-weight:700;white-space:nowrap}.label{display:block;font-size:25rpx;font-weight:600;margin:26rpx 0 12rpx}input{background:#f5f7fa;border:1rpx solid #e7ebf2;border-radius:14rpx;height:88rpx;padding:0 20rpx;font-size:27rpx}.hint{display:block;margin-top:10rpx;word-break:break-all}.check{display:flex;align-items:center;font-size:24rpx;color:#586a82;margin-top:24rpx}.notice{background:#f2f6fd;color:#60728f;font-size:24rpx;line-height:1.6;padding:18rpx;border-radius:14rpx;margin:20rpx 0}.primary{background:#294c89;color:white;margin-top:24rpx;font-size:29rpx}.error{color:#a65330;background:#fff3eb;padding:18rpx;border-radius:12rpx;margin:16rpx 0;font-size:24rpx}.history{padding:18rpx 0;border-bottom:1rpx solid #edf0f5;font-size:25rpx}.footer{text-align:center;margin-top:40rpx}.back{background:transparent;text-align:left;color:#456ba6;font-size:25rpx}.amount{font-size:48rpx;font-weight:700;margin-top:20rpx}.order-code{font-size:50rpx;font-weight:700;letter-spacing:8rpx;margin:12rpx 0}.section button + button{margin-top:14rpx}
