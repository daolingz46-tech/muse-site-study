.page { padding: 32rpx 28rpx 70rpx; } .heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:32rpx; }.eyebrow { color:#4668aa; font-size:24rpx; font-weight:700; }.title { font-size:46rpx; font-weight:750; margin:8rpx 0; }.muted { color:#7d899d; font-size:24rpx; }.panel,.order { background:#fff; border-radius:24rpx; padding:28rpx; margin-bottom:20rpx; box-shadow:0 6rpx 24rpx rgba(26,42,75,.04); }.panel-title { font-size:34rpx; font-weight:700; margin-bottom:12rpx; }.login input,.sheet textarea { box-sizing:border-box; width:100%; background:#f4f6fa; border-radius:14rpx; padding:20rpx; margin:24rpx 0; }.primary { background:#29457e; color:white; }.link { background:transparent; font-size:26rpx; color:#687a9b; }.notice { background:#eaf1ff; color:#526987; padding:22rpx; border-radius:16rpx; font-size:25rpx; line-height:1.5; }.sound { margin:20rpx 0; background:#fff; color:#355899; font-size:28rpx; }.metrics { display:flex; gap:12rpx; margin:24rpx 0; }.metrics view { flex:1; background:white; border-radius:18rpx; padding:20rpx; }.metrics text { display:block; }.metrics text { color:#8390a3; font-size:23rpx; }.metrics .metric-value { font-size:40rpx; margin-top:8rpx; }.filter { display:flex; gap:8rpx; margin-bottom:26rpx; }.filter button { flex:1; font-size:23rpx; padding:0; background:#e9edf4; color:#596a83; }.filter button.active { background:#29457e; color:white; }.list-head,.order-head,.sheet-head { display:flex; justify-content:space-between; align-items:center; }.list-head { font-weight:700; margin-bottom:18rpx; }.code,.product { font-weight:700; }.status { color:#456bac; font-size:24rpx; background:#eef3fc; padding:6rpx 14rpx; border-radius:20rpx; }.product { margin:18rpx 0; font-size:29rpx; }.detail { font-size:24rpx; color:#778499; margin:9rpx 0; word-break:break-all; }.actions { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:20rpx; }.actions button { margin:0; font-size:23rpx; padding:0 18rpx; background:#edf2fb; color:#34558b; }.empty { text-align:center; color:#8994a4; padding:40rpx; }.message { color:#a34b25; padding:20rpx; }.overlay { position:fixed; inset:0; background:rgba(18,28,48,.55); display:flex; align-items:flex-end; z-index:10; }.sheet { width:100%; background:white; border-radius:28rpx 28rpx 0 0; padding:30rpx; box-sizing:border-box; }.sheet-head { font-weight:700; font-size:32rpx; }.sheet-head button { margin:0; font-size:24rpx; }.history { max-height:65vh; white-space:pre-wrap; overflow-wrap:anywhere; font-size:25rpx; padding:20rpx 0; }.sheet textarea { height:260rpx; }
