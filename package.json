{
  "name": "muse-site-study",
  "version": "1.0.0",
  "private": true,
  "description": "Muse 账号与 Token 商店、订单管理工作台",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daolingz46-tech/muse-site-study.git"
  },
  "homepage": "https://daolingz46-tech.github.io/muse-site-study/",
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "build:store": "node scripts/build-store.mjs",
    "dev:store": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply muse-orders --local",
    "setup:admin": "node scripts/setup-admin.mjs",
    "deploy:store": "node scripts/deploy-store.mjs",
    "test:orders": "node --test tests/orders.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "^16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "miniflare": "^5.20261019.1-beta",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
